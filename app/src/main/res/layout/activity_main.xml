<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🔥 PLAN / CONTADOR -->
    <TextView
        android:id="@+id/txtPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plan: GRATUITO | Escaneos: 0/3"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#E3F2FD"/>

    <!-- BOTÓN ESCANEAR -->
    <Button
        android:id="@+id/btnScanIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escanear ingredientes"
        android:layout_marginTop="10dp"/>

    <!-- 🔥 TIP INTELIGENTE -->
    <TextView
        android:id="@+id/txtTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Tip: Hoy hay ofertas en frutas y verduras"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#FFF3E0"
        android:layout_marginTop="10dp"/>

    <!-- 🔥 SCROLL PARA RECETAS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- BOTÓN CARRITO -->
    <ImageButton
        android:id="@+id/btnGoToCart"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@android:drawable/ic_menu_agenda"
        android:layout_gravity="end"
        android:background="@android:color/transparent"/>

    <!-- 🔥 ADMOB BANNER -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"/>
        
</LinearLayout>
