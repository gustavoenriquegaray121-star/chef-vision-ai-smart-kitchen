<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/kitchen_bg"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/txtLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chef Vision IA"
        android:textSize="42sp"
        android:textColor="#FF5722"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Kitchen System"
        android:textSize="13sp"
        android:textColor="#DDDDDD"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtPlan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan: GRATUITO | Escaneos: 0/3"
        android:textSize="13sp"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:textColor="#FFD700"
        android:textSize="13sp"
        android:gravity="center"
        android:background="#33FFD700"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtPlan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="6dp"
        android:textColor="#EEEEEE"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/txtEvento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollRecetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/txtTip"
        app:layout_constraintBottom_toTopOf="@id/progressBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🆓 Cocinas gratuitas"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/layoutCocinasFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipMexicana"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇲🇽 Mexicana"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_free"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipItaliana"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇮🇹 Italiana"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_free"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipChina"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇨🇳 China"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_free"
                    android:padding="8dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Premium — $699/año"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipFrancesa"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇫🇷 Francesa 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipJaponesa"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇯🇵 Japonesa 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipEspanola"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇪🇸 Española 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipAmericana"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇺🇸 Americana 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipTailandesa"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🇹🇭 Tailandesa 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipMediterranea"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🫒 Mediterránea 🔒"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/glass_chip_premium"
                    android:padding="8dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 Plan Embajador — $899/año"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipVegana"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🥗 Vegana 🔒"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFD700"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipFitness"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="💪 Fitness 🔒"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFD700"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/chipMaridaje"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🍷 Maridaje 🔒"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#FFD700"
                    android:padding="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:indeterminateTint="#FF5722"
        app:layout_constraintBottom_toTopOf="@id/btnScanIngredients"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnScanIngredients"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:text="📸 SCAN"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/circle_scan_gourmet"
        android:elevation="12dp"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toTopOf="@id/btnGoToCart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnGoToCart"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="🛒 Mi Lista de Compras"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:paddingHorizontal="32dp"
        android:background="@drawable/btn_dark_green"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-3940256099942544/6300978111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
